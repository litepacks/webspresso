<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ pageTitle }}</title>
  <link rel="stylesheet" href="/css/demo.css">
  <script src="/js/client-demo.js" defer></script>
</head>
<body>
  <nav class="demo-nav">
    <a class="demo-nav-brand" href="/">⚡ Webspresso Client Behavior</a>
    <div class="demo-nav-links">
      <a href="/todos">1. Todo List (Full Showcase)</a>
      <a href="/counter" class="active">2. SSR Counter (Zero .client.*)</a>
    </div>
  </nav>

  <main>
    <h1>{{ pageTitle }}</h1>

    {{ fsy.fragment('count') }}

    <form class="demo-card" action="/api/counter" method="post" data-w-form="counter-increment">
      <label for="amount-input">Increment by:</label>
      <input id="amount-input" name="amount" type="number" value="1" min="1" max="100" required>
      <span data-w-error="amount"></span>
      <button type="submit">Increment</button>
      <p data-w-form-error></p>
    </form>
  </main>
</body>
</html>
