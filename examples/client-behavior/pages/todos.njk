<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ pageTitle }} — Webspresso</title>
  <link rel="stylesheet" href="/css/demo.css">
  <script src="/js/client-demo.js" defer></script>
</head>
<body>
  <nav class="demo-nav">
    <a class="demo-nav-brand" href="/">
      <span class="brand-icon">⚡</span>
      <span>Webspresso <strong>Client Behavior</strong></span>
    </a>
    <div class="demo-nav-links">
      <a href="/todos" class="active">1. Todo List Workspace</a>
      <a href="/counter">2. SSR Counter (Zero .client.*)</a>
    </div>
  </nav>

  <main data-w-controller="todos">
    <header class="page-header">
      <div class="header-titles">
        <div class="eyebrow-badge">SSR Fragments + Datastar Signals + Typed Forms</div>
        <h1>Task &amp; Engineering Backlog</h1>
        <p class="subtitle">
          Server renders HTML fragments (<code>todos-summary</code> &amp; <code>todos-list</code>);
          client handles instant filtering, accessible validation, and protected live draft editing.
        </p>
      </div>
      <div class="header-actions" data-w-controller="quick-share" data-testid="quick-share-widget">
        <button
          type="button"
          class="btn-ghost btn-sm"
          data-w-on:click="sharePage"
          data-share-text="Task & Engineering Backlog"
          data-testid="share-page-btn"
        >
          📋 Copy Workspace Title
        </button>
      </div>
    </header>

    <!-- Main Two-Column Workspace -->
    <div class="todos-workspace">
      <!-- Left Column: Quick-Add Composer + Filter Bar + Parent Summary Fragment (with Nested Task List) -->
      <section class="todos-main-col">
        <!-- Quick-Add Task Composer -->
        <form
          action="/api/todos"
          method="post"
          data-w-form="create-todo"
          data-w-clear="true"
          class="composer-card"
          novalidate
        >
          <div class="composer-top-row">
            <span class="composer-plus">+</span>
            <input
              name="title"
              type="text"
              class="composer-title-input"
              placeholder="Add a new task... (try typing 1–2 chars to test HTTP 422 validation)"
              autocomplete="off"
            >
            <button type="submit" class="btn-primary composer-submit-btn">Add Task</button>
          </div>
          <span data-w-error="title" class="composer-error"></span>

          <div class="composer-bottom-row">
            <div class="composer-meta-controls">
              <label class="inline-chip-select">
                <span>Priority</span>
                <select name="priority">
                  <option value="medium" selected>Medium</option>
                  <option value="high">High</option>
                  <option value="low">Low</option>
                </select>
              </label>

              <label class="inline-chip-select">
                <span>Category</span>
                <select name="category">
                  <option value="architecture" selected>architecture</option>
                  <option value="frontend">frontend</option>
                  <option value="backend">backend</option>
                  <option value="testing">testing</option>
                </select>
              </label>
            </div>

            <textarea
              name="notes"
              rows="1"
              class="composer-notes-input"
              placeholder="Optional sub-notes or acceptance criteria..."
            ></textarea>
          </div>
          <p data-w-form-error></p>
        </form>

        <!-- 1. Interactive Filter & Search Toolbar -->
        <div class="todos-filter-panel" data-testid="filter-toolbar">
          <div class="filter-top-bar">
            <div class="search-input-wrap">
              <span class="search-icon">⌕</span>
              <input
                type="search"
                name="search"
                value="{{ initialSearch }}"
                placeholder="Filter by title, category, or notes..."
                data-w-target="searchInput"
                data-w-model="draft.search"
                data-w-on:input="onSearchInput"
              >
            </div>

            <div class="filter-selects-group">
              <select data-w-target="statusSelect" data-w-model="draft.status" aria-label="Filter by status">
                <option value="all">Status: All</option>
                <option value="active">Status: Open</option>
                <option value="completed">Status: Done</option>
              </select>

              <select data-w-target="prioritySelect" data-w-model="draft.priority" aria-label="Filter by priority">
                <option value="all">Priority: All</option>
                <option value="high">Priority: High</option>
                <option value="medium">Priority: Medium</option>
                <option value="low">Priority: Low</option>
              </select>

              <button type="button" class="btn-primary btn-sm" data-w-on:click="applyFilters" data-testid="apply-filters-btn">Apply</button>
              <button type="button" class="btn-ghost btn-sm" data-w-on:click="resetFilters" data-testid="reset-filters-btn">Reset</button>
              <button type="button" class="btn-ghost btn-sm" data-w-on:click="copyFilterSummary" data-testid="copy-filter-summary-btn">📋 Copy Filter</button>
            </div>
          </div>

          <div class="filter-tabs-bar">
            <div class="Quick-pills">
              <span class="pills-label">Quick View:</span>
              <button type="button" class="pill-btn" data-w-on:click="setQuickStatus" data-status="all">All</button>
              <button type="button" class="pill-btn" data-w-on:click="setQuickStatus" data-status="active">Open Only</button>
              <button type="button" class="pill-btn" data-w-on:click="setQuickStatus" data-status="completed">Completed</button>
              <span class="meta-divider">|</span>
              <button type="button" class="pill-btn pill-high" data-w-on:click="setQuickPriority" data-priority="high">🔥 High Priority</button>
            </div>

            <div class="pagination-controls">
              <span class="draft-filter-summary" data-w-text="draftSummaryText" data-testid="draft-filter-summary">Draft: all/all</span>
              <span class="meta-divider">•</span>
              <span class="active-filter-summary" data-w-text="filterSummaryText" data-testid="applied-filter-summary">Filter: all/all • Page 1</span>
              <div class="pagination-btns">
                <button type="button" class="btn-ghost btn-sm" data-w-on:click="prevPage" data-testid="prev-page-btn">← Prev</button>
                <button type="button" class="btn-ghost btn-sm" data-w-on:click="nextPage" data-testid="next-page-btn">Next →</button>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Parent SSR Fragment: Project Summary + Nested Paginated Task List -->
        {{ fsy.fragment('summary', {}, { instanceId: 'todos-summary' }) }}
      </section>

      <!-- Right Column: Sticky Draft Inspector + Insights Task + Sibling Activity Fragment + Stress Lab Control Panel -->
      <aside class="todos-side-col">
        <!-- 4. Protected Active Edit / Draft Inspector -->
        <form
          action="/api/todos/3"
          method="patch"
          data-w-form="edit-todo"
          data-w-preserve-draft="true"
          data-w-persist-draft="session"
          data-w-draft-scope="todo-3"
          id="todo-draft-form"
          class="demo-card draft-card"
          data-w-target="editForm"
          data-testid="open-edit-form"
          novalidate
        >
          <div class="draft-header">
            <div class="draft-title-group">
              <span class="draft-shield-icon">🛡</span>
              <h2>Draft Inspector</h2>
            </div>
            <span class="draft-badge" data-w-text="editingBadge" data-testid="editing-badge">Task #3</span>
          </div>

          <div class="draft-callout">
            <strong>DOM Morph Protection Active:</strong> Edit the fields below and leave them unsaved while you toggle, add, or delete tasks on the left — your text and cursor focus are never lost.
          </div>

          <div class="field-group">
            <label for="draft-title-input">Task Title</label>
            <input
              id="draft-title-input"
              name="title"
              type="text"
              value="{{ initialEditTodo.title }}"
              data-w-target="editTitle"
              data-testid="edit-draft-title"
            >
            <span data-w-error="title"></span>
          </div>

          <div class="form-grid-2">
            <div class="field-group">
              <label for="draft-priority-select">Priority</label>
              <select id="draft-priority-select" name="priority" data-w-target="editPriority">
                <option value="high" {% if initialEditTodo.priority == 'high' %}selected{% endif %}>High (Critical)</option>
                <option value="medium" {% if initialEditTodo.priority == 'medium' %}selected{% endif %}>Medium</option>
                <option value="low" {% if initialEditTodo.priority == 'low' %}selected{% endif %}>Low</option>
              </select>
            </div>
            <div class="field-group">
              <label for="draft-category-input">Category</label>
              <input id="draft-category-input" name="category" type="text" value="{{ initialEditTodo.category }}" data-w-target="editCategory">
            </div>
          </div>

          <div class="field-group">
            <label for="draft-notes-textarea">Detailed Notes / Scratchpad</label>
            <textarea
              id="draft-notes-textarea"
              name="notes"
              data-w-target="editNotes"
              data-testid="edit-draft-content"
            >{{ initialEditTodo.notes }}</textarea>
            <span data-w-error="notes"></span>
          </div>

          <div class="form-actions-row">
            <button type="submit" class="btn-primary" data-w-disabled="isLoadingRecord" data-testid="save-edit-btn">Save Inspector Changes</button>
            <button type="button" class="btn-ghost" data-w-on:click="resetDraftForm" data-testid="reset-draft-btn">Reset Draft</button>
          </div>
          <p data-w-form-error></p>
        </form>

        <!-- 5. Client-Managed Data: Insights Task (latest, pending, error, stale, focus/reconnect/polling) -->
        <div class="demo-card insights-card">
          <div class="insights-header">
            <h2>📊 Live Telemetry &amp; Insights</h2>
            <span class="client-pill">Client Task (<code>tasks.insights</code>)</span>
          </div>
          <p class="card-hint">
            Fetches JSON from <code>GET /api/todos/insights</code> and binds it directly to controller-local Datastar signals (<code>data-w-text</code>, <code>data-w-show</code>).
          </p>

          <button
            type="button"
            class="btn-secondary full-width-btn"
            data-w-on:click="loadInsights"
            data-w-disabled="tasks.insights.pending"
            data-testid="load-insights-btn"
          >
            ↻ Fetch Live Insights via API
          </button>

          <div class="insights-status-row">
            <span data-testid="insights-pending-flag" data-w-text="tasks.insights.pending">false</span>
            <span data-testid="insights-stale-flag" data-w-text="tasks.insights.stale">false</span>
            <span data-testid="insights-error-text" data-w-text="insightsErrorText"></span>
          </div>

          <div class="insights-result" data-w-show="hasInsights" data-testid="insights-panel" hidden>
            <p class="insights-headline" data-w-text="insightsHeadline" data-testid="insights-headline"></p>
            <p class="insights-detail" data-w-text="insightsDetail" data-testid="insights-detail"></p>
          </div>
        </div>

        <!-- 3. Sibling SSR Fragment: Activity Feed (shares request-scoped memo with summary) -->
        {{ fsy.fragment('activity', { limit: 6 }, { instanceId: 'todos-activity' }) }}

        <!-- 7. Test Control & Fault Injection Area (Dev/Test Only) -->
        {% if isDev != false %}
        <div class="demo-card stress-lab-card" data-testid="stress-lab-panel">
          <div class="insights-header">
            <h2>🧪 Stress Lab Control &amp; Telemetry</h2>
            <span class="client-pill">Dev / Test Only</span>
          </div>
          <div class="stress-lab-controls">
            <button type="button" class="btn-ghost btn-sm" data-w-on:click="syncLabTelemetry" data-testid="lab-sync-btn">↻ Sync Telemetry</button>
            <button type="button" class="btn-ghost btn-sm" data-w-on:click="retryFailedFragments" data-testid="lab-retry-refresh-btn">↺ Retry Failed Refresh</button>
          </div>
          <div class="stress-lab-metrics">
            <div>Active Controllers: <code data-testid="lab-active-controllers" data-w-text="labActiveControllers"></code></div>
            <div>Active Fragments: <code data-testid="lab-active-fragments" data-w-text="labActiveFragments"></code></div>
            <div>Host Count: <code data-testid="lab-host-count" data-w-text="labHostCount">0</code></div>
            <div>Request Order: <code data-testid="lab-request-order" data-w-text="labRequestOrder"></code></div>
            <div>Patch Order: <code data-testid="lab-patch-order" data-w-text="labPatchOrder"></code></div>
            <div>Assertions: <code data-testid="lab-assertions" data-w-text="labAssertions">READY</code></div>
          </div>
        </div>
        {% endif %}
      </aside>
    </div>
  </main>
</body>
</html>
