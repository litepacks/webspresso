<article class="post-card">
  <h3><a href="/posts/{{ post.slug }}">{{ post.title }}</a></h3>
  <p class="meta">
    {% if post.author %}by {{ post.author.name }}{% endif %}
    {% if post.category %} · <a href="/posts?category={{ post.category.slug }}">{{ post.category.name }}</a>{% endif %}
    · {{ post.views }} views
  </p>
  <p>{{ post.excerpt }}</p>
</article>

