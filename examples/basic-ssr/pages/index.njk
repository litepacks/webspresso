{% extends "layout.njk" %}

{% block content %}
<section style="background: white; border-radius: 8px; padding: 2rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);">
  <h1 style="font-size: 2rem; margin-top: 0; color: #0f172a;">{{ greeting }}</h1>
  <p style="color: #475569; font-size: 1.1rem; line-height: 1.6;">
    This is a minimal server-side rendered application running on Webspresso.
  </p>
  <div style="margin-top: 1.5rem; padding: 1rem; background: #f8fafc; border-left: 4px solid #0284c7; border-radius: 4px;">
    <strong>Server Time:</strong> <code>{{ serverTime }}</code>
  </div>
</section>
{% endblock %}
