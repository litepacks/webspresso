{
  "name": "webspresso",
  "version": "0.0.108",
  "description": "Minimal, production-ready SSR framework for Node.js with file-based routing, Nunjucks templating, built-in i18n, and CLI tooling",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./errors": {
      "types": "./index.d.ts",
      "default": "./core/errors/index.js"
    },
    "./plugins": "./plugins/index.js",
    "./plugins/polar": "./plugins/polar/index.js",
    "./plugins/polar/src/*": "./plugins/polar/src/*.js",
    "./plugins/*": "./plugins/*/index.js",
    "./realtime": "./core/realtime/index.js",
    "./services": {
      "types": "./index.d.ts",
      "default": "./core/services/index.js"
    },
    "./core": "./core/index.js",
    "./core/services": {
      "types": "./index.d.ts",
      "default": "./core/services/index.js"
    },
    "./core/auth": "./core/auth/index.js",
    "./core/auth/*": "./core/auth/*.js",
    "./core/errors": "./core/errors/index.js",
    "./core/orm": "./core/orm/index.js",
    "./core/queue": "./core/queue/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "webspresso": "./bin/webspresso.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run tests/unit/ tests/plugins/unit/",
    "test:integration": "vitest run tests/integration/ tests/plugins/integration/",
    "test:security": "vitest run tests/security/",
    "security": "vitest run tests/security/ && npm audit --audit-level=critical",
    "test:orm": "vitest run tests/**/orm* tests/**/database*",
    "test:auth": "vitest run tests/**/auth* tests/unit/server-auth-branches.test.js",
    "test:admin": "vitest run tests/**/admin*",
    "test:services": "vitest run tests/unit/services/ tests/**/service*",
    "test:plugins": "vitest run tests/plugins/",
    "test:core": "vitest run tests/unit/core* tests/unit/server* tests/unit/routing* tests/unit/template*",
    "test:branches": "vitest run tests/unit/*scenarios*.test.js tests/unit/*branches*.test.js",
    "test:fast": "vitest run tests/unit/*scenarios*.test.js tests/unit/*branches*.test.js tests/unit/auth.test.js tests/unit/services/services.test.js tests/unit/server.test.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:quick": "vitest run --coverage",
    "test:coverage:changed": "vitest run --coverage --changed",
    "test:coverage:full": "FULL_REPORT=true vitest run --coverage",
    "test:coverage:branches": "vitest run tests/unit/*scenarios*.test.js tests/unit/*branches*.test.js --coverage",
    "test:coverage:unit": "vitest run tests/unit/ --coverage",
    "test:coverage:core": "vitest run tests/unit/core* tests/unit/server* tests/unit/routing* tests/unit/template* --coverage",
    "test:coverage:auth": "vitest run tests/**/auth* tests/unit/server-auth-branches.test.js --coverage",
    "test:coverage:orm": "vitest run tests/**/orm* tests/**/database* --coverage",
    "test:coverage:services": "vitest run tests/**/service* --coverage",
    "test:coverage:plugins": "vitest run tests/**/plugin* tests/unit/*plugin*.test.js --coverage",
    "test:coverage:fast": "vitest run tests/unit/*scenarios*.test.js tests/unit/*branches*.test.js tests/unit/auth.test.js tests/unit/services.test.js tests/unit/server.test.js --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "bench": "vitest bench --run",
    "bench:compare": "vitest bench --run --compare benchmark-results.json",
    "bench:baseline": "vitest bench --run --outputJson benchmarks/ci-baseline.json",
    "bench:ci": "vitest bench --run --outputJson benchmarks/current-benchmark.json && node scripts/check-bench-regression.mjs benchmarks/ci-baseline.json benchmarks/current-benchmark.json",
    "bench:ci:local": "npm run bench:baseline && npm run bench:ci",
    "check:types": "tsc --project tests/ts-smoke/tsconfig.json && tsc --noEmit --skipLibCheck false --types node index.d.ts",
    "rebuild:native": "npm rebuild better-sqlite3 bcrypt sharp",
    "docs:dev": "docboot dev ./docs",
    "docs:build": "docboot build ./docs",
    "docs:serve": "docboot serve dist",
    "docs:doctor": "docboot doctor ./docs",
    "release": "release-it"
  },
  "keywords": [
    "ssr",
    "nunjucks",
    "express",
    "file-based-routing",
    "i18n",
    "framework",
    "orm",
    "knex"
  ],
  "author": "cond",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/litepacks/webspresso.git"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "bin/",
    "src/",
    "core/",
    "plugins/",
    "views/partials/webspresso-client-runtime.njk"
  ],
  "dependencies": {
    "commander": "^11.1.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.2",
    "dayjs": "^1.11.19",
    "express": "^5.2.1",
    "express-session": "^1.18.0",
    "helmet": "^7.2.0",
    "inquirer": "^8.2.6",
    "knex": "^3.1.0",
    "multer": "^2.4.0",
    "nunjucks": "^3.2.4",
    "qs": "^6.16.0",
    "sanitize-html": "^2.18.1",
    "yaml": "^2.8.3",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "peerDependencies": {
    "@faker-js/faker": ">=8.0.0",
    "@swup/head-plugin": ">=2.0.0",
    "@swup/scripts-plugin": ">=2.0.0",
    "alpinejs": ">=3.0.0",
    "bcrypt": ">=5.0.0",
    "better-sqlite3": ">=9.0.0",
    "dotenv": ">=16.0.0",
    "exceljs": ">=4.0.0",
    "express-rate-limit": ">=8.0.0",
    "mjml": ">=5.0.0",
    "mysql2": ">=3.0.0",
    "nodemailer": ">=6.0.0",
    "pg": ">=8.0.0",
    "sharp": ">=0.33.0",
    "swup": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "bcrypt": {
      "optional": true
    },
    "express-rate-limit": {
      "optional": true
    },
    "dotenv": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "@faker-js/faker": {
      "optional": true
    },
    "sharp": {
      "optional": true
    },
    "exceljs": {
      "optional": true
    },
    "mjml": {
      "optional": true
    },
    "nodemailer": {
      "optional": true
    },
    "@swup/head-plugin": {
      "optional": true
    },
    "@swup/scripts-plugin": {
      "optional": true
    },
    "alpinejs": {
      "optional": true
    },
    "swup": {
      "optional": true
    }
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.48.0",
    "@swup/head-plugin": "^2.3.1",
    "@swup/scripts-plugin": "^2.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^4.1.11",
    "alpinejs": "^3.15.11",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^11.10.0",
    "chokidar": "^4.0.3",
    "docboot": "^0.3.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express-rate-limit": "^8.4.1",
    "hono": "^4.13.13",
    "mjml": "^5.4.0",
    "nodemailer": "^10.0.10",
    "release-it": "^20.2.1",
    "sharp": "^0.35.5",
    "softscope": "^0.3.2",
    "supertest": "^6.3.4",
    "swup": "^4.8.3",
    "typescript": "~5.6.3",
    "vitest": "^4.1.11",
    "vitest-doctor": "^0.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "basic-ftp": "^6.2.1",
    "chokidar": "^4.0.3",
    "katex": "^0.18.2",
    "tar": "^7.5.11",
    "undici": "^6.28.1",
    "uuid": "^11.1.1",
    "js-yaml": "^5.4.2",
    "qs": "^6.16.0",
    "sanitize-html": "^2.18.1",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
