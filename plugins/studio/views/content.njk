<h1>Content layer</h1>
{% if not content.enabled %}
<p class="muted">{{ content.message }}</p>
{% else %}
<p class="muted">Directory: <code>{{ content.dir }}</code> · {{ content.totalItems }} item(s)</p>
{% for col in content.collections %}
<section class="section">
  <h2>{{ col.name }}</h2>
  <div class="cards">
    <div class="card"><h3>Published</h3><div class="value">{{ col.count }}</div></div>
    <div class="card"><h3>Drafts</h3><div class="value">{{ col.draftCount }}</div></div>
    <div class="card"><h3>Sitemap</h3><div class="value">{{ col.sitemapCount }}</div></div>
    <div class="card"><h3>Missing meta</h3><div class="value">{{ col.missingMeta }}</div></div>
  </div>
  {% if col.sample.length %}
  <table class="table">
    <thead><tr><th>Slug</th><th>Title</th><th>Draft</th><th>Sitemap</th></tr></thead>
    <tbody>
    {% for item in col.sample %}
      <tr>
        <td><code>{{ item.slug }}</code></td>
        <td>{{ item.title }}</td>
        <td>{{ 'yes' if item.draft else 'no' }}</td>
        <td>{{ 'yes' if item.sitemap else 'no' }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}
</section>
{% endfor %}
{% endif %}
