<h1>Environment inspector</h1>
{% if not exposeValues %}
<p class="muted">Values are hidden. Set <code>studio.exposeEnv: true</code> to show non-secret values.</p>
{% endif %}
{% if missing.length %}
<h2>Missing</h2>
<ul>{% for m in missing %}<li class="mono">{{ m.key }}</li>{% endfor %}</ul>
{% endif %}
{% if warnings.length %}
<h2>Warnings</h2>
<ul>{% for w in warnings %}<li>{{ w.key }}: {{ w.message }}</li>{% endfor %}</ul>
{% endif %}
<table class="data">
  <thead><tr><th>Variable</th><th>Present</th><th>Value</th></tr></thead>
  <tbody>
  {% for e in entries %}
  <tr>
    <td class="mono">{{ e.key }}</td>
    <td>{% if e.present %}yes{% else %}no{% endif %}</td>
    <td>{% if e.masked %}••••••••{% elif e.value %}{{ e.value }}{% else %}—{% endif %}</td>
  </tr>
  {% endfor %}
  </tbody>
</table>
