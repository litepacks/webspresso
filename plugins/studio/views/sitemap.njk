<h1>Sitemap preview</h1>
<div class="cards">
  <div class="card"><h3>Total URLs</h3><div class="value">{{ sitemap.totalUrls }}</div></div>
  <div class="card"><h3>Static</h3><div class="value">{{ sitemap.staticUrls }}</div></div>
  <div class="card"><h3>Dynamic</h3><div class="value">{{ sitemap.dynamicUrls }}</div></div>
</div>
<p><a class="link" href="{{ sitemap.sitemapXmlUrl }}">sitemap.xml</a> · <a class="link" href="{{ sitemap.robotsTxtUrl }}">robots.txt</a></p>
